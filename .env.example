# Copy to .env and fill in. Never commit .env.

# Required
IKIMINA_DB_PASSWORD=
# Generate with: openssl rand -hex 32
IKIMINA_JWT_SECRET=

# Optional
IKIMINA_DB_NAME=ikimina_db
IKIMINA_DB_USERNAME=postgres
IKIMINA_JWT_EXPIRATION=86400000
IKIMINA_SUPERADMIN_EMAIL=superadmin@ikimina.com
# Leave blank to have a random one generated and printed once on first boot.
IKIMINA_SUPERADMIN_PASSWORD=
IKIMINA_CORS_ORIGINS=http://localhost:8080
IKIMINA_HTTP_PORT=8080
SPRING_PROFILES_ACTIVE=prod