# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit it (Hard Rule H6).
# Generate each secret with:  openssl rand -hex 32

# --- PostgreSQL superuser (container bootstrap only; the app never uses it) ---
POSTGRES_PASSWORD=

# --- Schema owner: runs Flyway migrations ---
IKIMINA_DB_OWNER_USERNAME=ikimina_owner
IKIMINA_DB_OWNER_PASSWORD=

# --- Runtime role: what the application connects as (not an owner, not a superuser) ---
IKIMINA_DB_APP_USERNAME=ikimina_app
IKIMINA_DB_APP_PASSWORD=

IKIMINA_DB_NAME=ikimina

# --- Authentication (spec 16.1). Both required, at least 32 bytes each. ---
# Signs access tokens. Rotating it signs everyone out.
IKIMINA_JWT_SECRET=
# Keys the hash of one-time SMS codes.
IKIMINA_OTP_PEPPER=

# --- SMS (spec 14.1 [OPEN]) ---
# Only "fake" exists until a provider is chosen. With "fake" no SMS is delivered; in the
# dev profile the codes appear in the application log instead.
IKIMINA_SMS_PROVIDER=fake

# --- Web ---
# Browser origins allowed to call the API (comma-separated, no wildcards).
IKIMINA_CORS_ORIGINS=http://localhost:5173
# Where invitation links in SMS point.
IKIMINA_WEB_BASE_URL=http://localhost:5173

# --- Application ---
# dev enables Swagger UI, debug logging, plain-http refresh cookie and the dev platform admin.
SPRING_PROFILES_ACTIVE=dev
IKIMINA_BACKEND_PORT=8082
# Host port for local tools (psql, IDE); change if 5432 is taken by another PostgreSQL.
IKIMINA_DB_HOST_PORT=5432
# dev only: password for the seeded platform admin (+250780000001). Blank = generated and logged once.
IKIMINA_DEV_PLATFORM_ADMIN_PASSWORD=
