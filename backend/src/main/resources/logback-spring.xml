<?xml version="1.0" encoding="UTF-8"?>
<!--
  Readable console logs outside production; one JSON object per line in
  production so logs are queryable and stack traces stay attached to their event.
  Every line carries requestId (RequestIdFilter). From Phase 1, groupId and userId
  join it.

  Spec 16.6: never log secrets, full tokens, OTPs or full national IDs. The mask
  below is a safety net for structured fields, not a licence to log them.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{requestId:-no-request}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>groupId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <timeZone>UTC</timeZone>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
                <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                    <defaultMask>****</defaultMask>
                    <path>password</path>
                    <path>token</path>
                    <path>accessToken</path>
                    <path>refreshToken</path>
                    <path>secret</path>
                    <path>otp</path>
                    <path>authorization</path>
                    <path>nationalId</path>
                </jsonGeneratorDecorator>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
