# Copy to .env and fill in real values. Never commit .env.
# Load with: set -a && . ./.env && set +a   (or configure your IDE run config)

# --- Database ---
IKIMINA_DB_HOST=localhost
IKIMINA_DB_PORT=5432
IKIMINA_DB_NAME=ikimina_db
IKIMINA_DB_USERNAME=postgres
IKIMINA_DB_PASSWORD=change-me

# --- JWT signing key ---
# Must be at least 32 bytes. Generate one with:
#   openssl rand -hex 32
# The key previously committed to application.properties is COMPROMISED and
# must not be reused - anyone with repository access can forge admin tokens.
IKIMINA_JWT_SECRET=
IKIMINA_JWT_EXPIRATION=86400000

# --- Bootstrap super admin (first boot only) ---
IKIMINA_SUPERADMIN_EMAIL=superadmin@ikimina.com
IKIMINA_SUPERADMIN_PASSWORD=

# --- CORS / server ---
IKIMINA_CORS_ORIGINS=http://localhost:3000
IKIMINA_SERVER_PORT=8082

# --- Local dev noise (optional) ---
IKIMINA_SHOW_SQL=false
IKIMINA_LOG_LEVEL_APP=DEBUG
